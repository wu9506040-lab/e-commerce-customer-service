# =============================================================
# 智能客服 Agent 系统 - 环境变量模板
# 复制为 .env.dev 后填入真实值，.env 文件加入 .gitignore
#
# 字段顺序与 backend/app/core/config.py 对齐（pydantic-settings）
# =============================================================

# ---- 数据卷根路径（所有持久化数据都在这下面）----
# Windows 路径用反斜杠，Docker Desktop 自动转换
DATA_ROOT=E:\DockerData\volumes

# ---- Compose 项目名（影响容器/网络/卷前缀）----
COMPOSE_PROJECT_NAME=customer-service

# ---- MySQL 配置 ----
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=change_me_user_password

# ---- Qwen (DashScope) LLM 配置 ----
# API Key 从 https://dashscope.console.aliyun.com/apiKey 获取
QWEN_API_KEY=sk-change_me_qwen_api_key
# DashScope OpenAI 兼容模式端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型（可选: qwen-max / qwen-plus / qwen-turbo / qwen-long）
QWEN_MODEL=qwen-max  # 免费额度 per-model：plus/turbo 耗尽可切 qwen-max/flash（控制台模型观测页查）

# ---- Qdrant 向量库配置 ----
# QDRANT_URL 走 docker compose 内置（http://qdrant:6333），无需外部覆盖
QDRANT_COLLECTION=knowledge_base

# ---- JWT 配置 ----
# 至少 32 字符随机字符串（生产必须替换为 openssl rand -hex 32 生成的强密钥）
JWT_SECRET=change_me_at_least_32_chars_random_xxx_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- bcrypt 配置 ----
# 密码哈希轮数（10-14 之间；越慢越安全）
BCRYPT_ROUNDS=12

# ---- Cookie 配置 ----
# dev 下 COOKIE_SECURE=false 便于 curl；生产必须 true
COOKIE_NAME=cs_token
COOKIE_MAX_AGE=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- 应用配置 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Feature Flags（灰度开关 · 真值三源：config.py 默认值 ← compose 注入 ← 本文件）----
# 改本文件即生效（compose 已全部注入，无需重新 build 镜像）。
# 改 config.py 默认值时须同步本文件与 compose，否则产生"三源漂移"（审计报告 §6.6）。

# V3 LangGraph 退款引擎（true=RefundFlow 主引擎 / false=降级 V2）
USE_LANGGRAPH_REFUND=false
# Demo 访客登录（公开 demo 站点一键体验；生产环境建议 false）
ENABLE_DEMO_LOGIN=true
# Phase 4 A4 Multi-Query 检索增强（N 路变体 → RRF 融合）
ENABLE_MULTI_QUERY=false
# P2 长程记忆：跨 session 用户画像
ENABLE_USER_PROFILE=false
# Sprint 5 Prompt 版本管理（manifest 多版本）
ENABLE_PROMPT_VERSIONING=false
# C2 Agent Function Calling（true=GeneralistAgent 全科兜底）
ENABLE_AGENT_FC=false
# M14 ContextService 是否读写 conversation_contexts 表
ENABLE_CONTEXT_STORE=false
# M14 OrderContextResolver 是否参与订单决策
ENABLE_ORDER_RESOLVER=false
# M14 business_flow 工厂（显式状态机）
ENABLE_BUSINESS_FLOW=false
# M14 SSE meta 事件携带 OrderCard payload（关闭则兼容老前端）
SSE_CARD_V2=true
# M14 V3 转人工兜底（EscalationService + handoff payload）
ENABLE_ESCALATION_HANDOFF=false
# V15 用户上下文预加载（最近 5 单 + 画像注入 prompt）
ENABLE_USER_CONTEXT_PRELOAD=false
# V16 闲鱼 MCP 工具（需 GOOFISH_COOKIE_PATH + goofish-cli）
ENABLE_XIANYU_TOOLS=false
# V21 M3-2 双意图双专家协作（次意图补答）
ENABLE_DUAL_INTENT_DISPATCH=false
